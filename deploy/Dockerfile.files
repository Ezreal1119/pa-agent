FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM ubuntu:24.04
COPY --from=build /usr/local/bin/node /usr/local/bin/node
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv fonts-noto-cjk ca-certificates libstdc++6 libatomic1 && rm -rf /var/lib/apt/lists/*
COPY requirements-files.txt requirements-files.lock /app/
RUN python3 -m venv /opt/converter && /opt/converter/bin/pip install --no-cache-dir -r /app/requirements-files.txt
ENV PATH="/opt/converter/bin:$PATH"
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./
CMD ["node", "--max-old-space-size=384", "dist/file-tools/worker.js"]
