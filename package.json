{
  "name": "pi-patrick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./files": {
      "types": "./dist/file-tools/index.d.ts",
      "import": "./dist/file-tools/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:office-xml": "npm run build && NODE_ENV=production FILE_WORKER_IMAGE= node --test tests/office-xml-encoding.test.mjs",
    "web": "npm run build && node dist/web/cli.js",
    "wecom:bridge": "node integrations/wecom-bridge/index.mjs",
    "test:wecom": "npm run build && node --test tests/wecom-*.test.mjs",
    "test:web-tools": "npm run build && node --test tests/web-tools.test.mjs",
    "test:mcp": "npm run build && node --test tests/mcp.test.mjs",
    "test:file-create": "npm run build && NODE_ENV=production FILE_WORKER_IMAGE= node --test tests/file-create.test.mjs",
    "test:prompt": "npm run build && node --test tests/prompt*.test.mjs tests/session-policy.test.mjs",
    "test:sync": "npm run build && node --test tests/knowledge-sync*.test.mjs",
    "check:sync": "node scripts/check-sync-runtime.mjs",
    "sftp:sync": "npm run build && node dist/sftp-sync/cli.js",
    "test:sftp": "npm run build && node --test tests/sftp-sync*.test.mjs",
    "sftp:check-host": "npm run build && node dist/sftp-sync/probe.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@napi-rs/canvas": "1.0.2",
    "@wecom/aibot-node-sdk": "1.0.7",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.2",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.10.1",
    "jszip": "3.10.2",
    "marked": "^18.1.1",
    "pdfjs-dist": "6.1.200",
    "proper-lockfile": "4.1.2",
    "ssh2": "1.17.0",
    "typebox": "1.3.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "4.1.4",
    "@types/ssh2": "1.15.6",
    "pdf-lib": "1.17.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
