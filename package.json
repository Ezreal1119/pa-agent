{
  "name": "pi-patrick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./files": {
      "types": "./dist/file-tools/index.d.ts",
      "import": "./dist/file-tools/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "web": "npm run build && node dist/web/cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@napi-rs/canvas": "1.0.2",
    "dompurify": "^3.4.17",
    "dotenv": "^17.2.2",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.10.1",
    "jszip": "3.10.2",
    "marked": "^18.1.1",
    "pdfjs-dist": "6.1.200",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "pdf-lib": "1.17.1",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
