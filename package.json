{
  "name": "pi-patrick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "npm run dev --workspace web",
    "build": "npm run typecheck && npm run build --workspace web",
    "start": "NODE_ENV=production tsx src/index.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace web"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "dotenv": "^17.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
