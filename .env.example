# Pi Patrick only supports OpenAI-compatible Chat Completions models.
# Never commit your real API key.
API_KEY=

# API root URL. Do not include /chat/completions.
# Bailian example:
# BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DeepSeek example:
# BASE_URL=https://api.deepseek.com
BASE_URL=

# Bailian example: qwen3.8-max
# DeepSeek example: deepseek-v4-pro
MODEL_ID=

# Optional model metadata used by Pi for context management.
CONTEXT_WINDOW=128000
MAX_TOKENS=16384

# Optional storage and workspace overrides.
AGENT_CWD=.
AGENT_DATA_DIR=.data

# AGENT_DATA_DIR must contain urovo-product-expert/SKILL.md and knowledge.
# Required main memory: AGENT_DATA_DIR/memory/urovo-product-expert/MEMORY.md.
# Optional on-demand UMS skill: ums-expert/SKILL.md and references/ (no MEMORY loading).
# Optional extra memory: AGENT_DATA_DIR/memory/urovo-product-expert/MEMORY_EXTRA.md (may be empty).
# Only the memory tool (action=add/edit/delete) can change that extra file.
# Five rounds include the current request; sessions expire after 30 idle days.

# Optional local Web test interface port (loopback only).
WEB_PORT=4321
# Optional HTTPS reverse-proxy origin; no /login path. Blank keeps local-only access.
# Example: https://urovo-agent.patrick-shenzhen.cn
WEB_PUBLIC_URL=

# Required Web administrator login. Set both; there are no default credentials.
# Restart the Web server after changing these values. Never commit real passwords.
ADMIN_ACCOUNT=
ADMIN_PASSWORD=

# Vision Recognition Setup
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=

# Optional separate DeepSeek key for search/fetch; blank reuses API_KEY only when
# BASE_URL points directly to https://api.deepseek.com. Other providers are not reused.
# Web Agent settings control search and fetch independently (both initially off).
# DEEPSEEK_API_KEY=

# Optional file tools. Online and library-link switches are independent.
# Restart after changing the switch or vision settings.
# Initial Web default for the original six file tools. excel_create/text_file_create
# are initially off; enable them independently in Agent settings. Saved .data/web-agent-settings.json preferences take precedence.
FILE_TOOLS_ENABLED=false
# Dedicated converter environment: python3 -m venv .data/file-runtime
# .data/file-runtime/bin/pip install -r requirements-files.txt
# MARKITDOWN_COMMAND=/absolute/path/to/.data/file-runtime/bin/markitdown
# Native Linux production: leave FILE_WORKER_IMAGE unset and use
# deploy/product-expert.service for aggregate memory limits and read-only knowledge.
# Optional Docker backend (not required): build an image and set its name below.
# docker build -f deploy/Dockerfile.files -t product-expert-files:local .
# FILE_WORKER_IMAGE=product-expert-files:local
# Conservative starting limits; adjust after measuring real business files.
FILE_MAX_BYTES=31457280
FILE_MAX_EXPANDED_BYTES=67108864
FILE_MAX_CELLS=50000
FILE_MAX_SHEETS=20
FILE_MAX_PAGES=100
FILE_TIMEOUT_MS=120000
FILE_QUEUE_LIMIT=8
VISION_TIMEOUT_MS=60000
VISION_MAX_CALLS=8

# Shared Agent execution limit for Web, WeCom and MCP. File workers remain globally serial.
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_RUN_QUEUE_LIMIT=8

# Optional WeCom smart-bot long connection. No WeCom account/password is required.
# Keep false until credentials and the two systemd units have been installed.
WECOM_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Same local secret used by Agent and Bridge; generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WECOM_API_TOKEN=
# Uses WEB_PORT when unset. Only loopback HTTP is accepted.
# WECOM_AGENT_URL=http://127.0.0.1:4321
WECOM_MAX_CONCURRENT_RUNS=2
WECOM_QUEUE_LIMIT=8
WECOM_RUN_TIMEOUT_MS=900000
# Optional multiple bots (replaces WECOM_BOT_ID/SECRET); JSON, no repeated IDs:
# WECOM_BOTS='[{"botId":"bot-1","secret":"..."},{"botId":"bot-2","secret":"..."}]'

# Optional incoming-message notifications; blank disables forwarding (contacts still register).
# The recipient is also excluded as sender, including inside groups.
WECOM_NOTIFY_USER_ID=
# Multi-bot WECOM_BOTS entries may override this using "notifyUserId".

# Optional Bearer-authenticated text-only MCP, served by product-expert at /mcp.
# Uses the same model and global Agent settings; Web admin authentication is unchanged.
# Initial default only; a saved Agent settings MCP toggle takes precedence.
MCP_ENABLED=false
# Required for all /mcp requests when enabled; blank rejects access with HTTP 401.
# Clients send: Authorization: Bearer <MCP_API_KEY>. Restart after changing this key.
MCP_API_KEY=
# Return a task handle if the answer is not ready within this period (0..25000 ms).
MCP_WAIT_MS=10000
# Total task deadline includes queue time; distinct conversations share the Agent gate.
MCP_TASK_TIMEOUT_MS=900000
MCP_PENDING_LIMIT=10

# Administrator Synchronize page; manual only, no scheduled collection.
# Independent of chat file-tool switches. Uses API_KEY/BASE_URL/MODEL_ID and global effort.
# Full visual conversion uses VISION_LLM_* above and requires native LibreOffice/fontconfig.
SYNC_SOFFICE_COMMAND=soffice
SYNC_FILE_TIMEOUT_MS=1800000
SYNC_MAX_MODEL_REQUESTS=64
SYNC_MAX_VISION_REQUESTS=128
# FILE_* upload, expansion, page/sheet/cell, worker timeout and queue limits still apply.
# Aggregate full Markdown retained in memory for one maintenance batch (16 MiB).
SYNC_MAX_BATCH_MARKDOWN_BYTES=16777216

# Optional manual SFTP imports (Synchronize > Source imports, or npm run sftp:sync).
# Credentials remain on the server; JSONL contains only {"path":"/remote/file.xlsx"}.
# Reports/state: AGENT_DATA_DIR/logs/sftp_sync; downloads: urovo-product-expert/newly_added.
# This does not run knowledge Sync, schedule jobs, or send WeCom notifications.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
# Pin the OpenSSH SHA256 fingerprint. npm run sftp:check-host observes without authentication.
SFTP_HOST_FINGERPRINT=
# Only enable for older Serv-U servers that require diffie-hellman-group14-sha1.
SFTP_LEGACY_KEX=false
# Relative to the project directory, or an absolute path. Keep outside Git.
SFTP_PATHS_FILE=.data/sftp_sync_paths.jsonl
# Optional finite budgets. At most one import across HTTP/CLI, one file at a time.
# SFTP_CONNECT_TIMEOUT_MS=20000
# SFTP_FILE_TIMEOUT_MS=600000
# SFTP_MAX_ATTEMPTS=3
# SFTP_DISK_RESERVE_BYTES=268435456
