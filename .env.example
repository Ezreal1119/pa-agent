# Pi Patrick only supports OpenAI-compatible Chat Completions models.
# Never commit your real API key.
API_KEY=

# API root URL. Do not include /chat/completions.
# Bailian example:
# BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DeepSeek example:
# BASE_URL=https://api.deepseek.com
BASE_URL=

# Bailian example: qwen3.8-max
# DeepSeek example: deepseek-v4-pro
MODEL_ID=

# Optional model metadata used by Pi for context management.
CONTEXT_WINDOW=128000
MAX_TOKENS=16384

# Optional storage and workspace overrides.
AGENT_CWD=.
AGENT_DATA_DIR=.data

# AGENT_DATA_DIR must contain urovo-product-expert/{SKILL,MEMORY}.md and knowledge.
# Optional on-demand UMS skill: ums-expert/SKILL.md and references/ (no MEMORY loading).
# Optional shared extra memory: AGENT_DATA_DIR/memory/MEMORY.md (may be empty).
# Only the memory tool (action=add/edit/delete) can change that extra file.
# Five rounds include the current request; sessions expire after 30 idle days.

# Optional local Web test interface port (loopback only).
WEB_PORT=4321

# Required Web administrator login. Set both; there are no default credentials.
# Restart the Web server after changing these values. Never commit real passwords.
ADMIN_ACCOUNT=
ADMIN_PASSWORD=

# Vision Recognition Setup
VISION_LLM_BASE_URL=
VISION_LLM_API_KEY=
VISION_LLM_MODEL=

# Optional file tools. false keeps the original five-tool Agent behavior.
# Restart after changing the switch or vision settings.
# Initial Web default; saved .data/web-agent-settings.json preferences take precedence.
FILE_TOOLS_ENABLED=false
# Dedicated converter environment: python3 -m venv .data/file-runtime
# .data/file-runtime/bin/pip install -r requirements-files.txt
# MARKITDOWN_COMMAND=/absolute/path/to/.data/file-runtime/bin/markitdown
# Native Linux production: leave FILE_WORKER_IMAGE unset and use
# deploy/product-expert.service for aggregate memory limits and read-only knowledge.
# Optional Docker backend (not required): build an image and set its name below.
# docker build -f deploy/Dockerfile.files -t product-expert-files:local .
# FILE_WORKER_IMAGE=product-expert-files:local
# Conservative starting limits; adjust after measuring real business files.
FILE_MAX_BYTES=31457280
FILE_MAX_EXPANDED_BYTES=67108864
FILE_MAX_CELLS=50000
FILE_MAX_SHEETS=20
FILE_MAX_PAGES=100
FILE_TIMEOUT_MS=120000
FILE_QUEUE_LIMIT=8
VISION_TIMEOUT_MS=60000
VISION_MAX_CALLS=8

# Shared Agent execution limit for BOTH Web and WeCom. File workers remain globally serial.
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_RUN_QUEUE_LIMIT=8

# Optional WeCom smart-bot long connection. No WeCom account/password is required.
# Keep false until credentials and the two systemd units have been installed.
WECOM_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
# Same local secret used by Agent and Bridge; generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
WECOM_API_TOKEN=
# Uses WEB_PORT when unset. Only loopback HTTP is accepted.
# WECOM_AGENT_URL=http://127.0.0.1:4321
WECOM_MAX_CONCURRENT_RUNS=2
WECOM_QUEUE_LIMIT=8
WECOM_RUN_TIMEOUT_MS=900000
# Optional multiple bots (replaces WECOM_BOT_ID/SECRET); JSON, no repeated IDs:
# WECOM_BOTS='[{"botId":"bot-1","secret":"..."},{"botId":"bot-2","secret":"..."}]'
