# Pi Patrick only supports OpenAI-compatible Chat Completions models.
# Never commit your real API key.
API_KEY=

# API root URL. Do not include /chat/completions.
# Bailian example:
# BASE_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# DeepSeek example:
# BASE_URL=https://api.deepseek.com
BASE_URL=

# Bailian example: qwen3.8-max
# DeepSeek example: deepseek-v4-pro
MODEL_ID=

# Optional model metadata used by Pi for context management.
CONTEXT_WINDOW=128000
MAX_TOKENS=16384

# Optional storage and workspace overrides.
AGENT_CWD=.
AGENT_DATA_DIR=.data

# CKD-only optional overrides. CKD_LIBRARY points to ckd-library-v2 itself.
# CKD_DATA_DIR=/your/app-data
# CKD_LIBRARY=/your/library/ckd-library-v2

# Production Web administrator login. Generate a salted hash with hashAdminPassword;
# keep the actual password out of this file and Git.
# CKD_ADMIN_USER=your-admin-account
# CKD_ADMIN_PASSWORD_HASH=scrypt:<32 hex salt>:<128 hex digest>
# CKD_ADMIN_ORIGIN=http://your-server-ip

# CKD image descriptions and SOP image framing checks (OpenAI-compatible Chat Completions).
# All three are required for uncached image analysis; no text-model fallback.
# VISION_BASE_URL=https://your-provider/compatible-mode/v1
# VISION_API_KEY=
# VISION_MODEL_ID=

# legacy 模式的七项图片评分策略在 Web「图片评分与设置」中保存，或使用 /api/images/policy。
# 策略文件：<CKD_DATA_DIR>/ckd/image-quality/policy.json；不影响 VISION_* 模型配置。

# Fixed pixel scoring. "legacy" (default) keeps historical visual scoring.
# VISION_* remains necessary for independent AI operation-focus checks.
# CKD_IMAGE_SCORER=pixel-v1.23.0
# CKD_SCORER_PYTHON=/opt/pi-patrick/.venv-scoring/bin/python
